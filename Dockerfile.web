FROM node:22-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_BAYROUTE_API_URL=https://bayroute-api.onrender.com
ENV NEXT_PUBLIC_BAYROUTE_API_URL=$NEXT_PUBLIC_BAYROUTE_API_URL
RUN npm run build

FROM node:22-slim
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /app ./
ENV HOST=0.0.0.0 \
    PORT=3000
EXPOSE 3000
CMD ["sh", "-c", "npm run start -- --ip 0.0.0.0 --port ${PORT:-3000}"]
