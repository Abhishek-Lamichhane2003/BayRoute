FROM node:22-slim AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
ARG NEXT_PUBLIC_BAYROUTE_API_URL=http://localhost:8000
ENV NEXT_PUBLIC_BAYROUTE_API_URL=$NEXT_PUBLIC_BAYROUTE_API_URL
RUN npm run build

FROM node:22-slim
WORKDIR /app
COPY --from=build /app ./
ENV HOST=0.0.0.0 \
    PORT=3000
EXPOSE 3000
CMD ["npm", "run", "start", "--", "--host", "0.0.0.0"]

