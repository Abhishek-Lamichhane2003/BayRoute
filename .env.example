# Frontend: leave blank to use the built-in browser demo dataset.
NEXT_PUBLIC_BAYROUTE_API_URL=http://localhost:8000

# Backend
DATABASE_URL=sqlite:///./bayroute.db
CORS_ORIGINS=http://localhost:3000
AUTO_SEED_DEMO=true
MODEL_ARTIFACT_PATH=./artifacts/delay_model.joblib

# Live collection: paste a GTFS-Realtime Trip Updates endpoint here.
# The literal {api_key} is replaced with TRANSIT_511_API_KEY when present.
GTFS_RT_TRIP_UPDATES_URL=
TRANSIT_511_API_KEY=
COLLECTOR_KEY=change-me

